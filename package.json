{
  "name": "record-studio",
  "version": "0.1.0",
  "description": "Grabador multicam (pantalla + webcam sincronizadas) que entrega un proyecto listo para que la skill video-use componga el vídeo final con planos automáticos y HyperFrames.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty-prebuilt-multiarch || true",
    "rebuild-pty": "electron-rebuild -f -w node-pty-prebuilt-multiarch"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^33.2.0"
  },
  "dependencies": {
    "@vpalmisano/virtual-background": "^1.0.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "hyperframes": "^0.6.121",
    "node-pty-prebuilt-multiarch": "^0.10.1-pre.5"
  }
}
